{
  "version": 2,
  "builds": [
    {
      "src": "vercel_wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11",
        "requirementsPath": "requirements-vercel.txt"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },    {
      "src": "/(.*)",
      "dest": "/vercel_wsgi.py"
    }
  ],
  "env": {
    "FLASK_APP": "vercel_wsgi.py",
    "FLASK_ENV": "production",
    "PYTHONPATH": "."
  }
}
